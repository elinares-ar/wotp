# Copiar a .env con permisos 600; los secretos reales nunca se versionan.
APP_ENV=production
APP_NAME=WOTP
APP_URL=https://wotp.pruebas-ia.org/gateway
DASHBOARD_ORIGIN=https://wotp.pruebas-ia.org
SECRET_KEY=
WOTP_FERNET_KEY=
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
WOTP_PB_COLLECTIONS_PREFIX=waotp_
DEFAULT_COUNTRY_CODE=54
OTP_LENGTH=6
CODE_TTL_SECONDS=300
MAX_ATTEMPTS=3
RATE_LIMIT_ENABLED=1
RATELIMIT_PER_MIN=10
RATELIMIT_PER_IP_PER_MIN=30
TRUST_PROXY_HEADERS=1
MONTHLY_SEND_QUOTA=500
WOTP_MOCK_DELIVERY=0
WHATSAPP_PROVIDER=meta
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=https://wotp.pruebas-ia.org
NEXT_PUBLIC_API_URL=https://wotp.pruebas-ia.org/gateway
NEXT_PUBLIC_PB_URL=https://wotp.pruebas-ia.org/pb
NEXT_PUBLIC_SENTRY_DISABLED=true
